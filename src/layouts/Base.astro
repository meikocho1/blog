---
import { SITE, UI } from '../posts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  topics?: string[];
  jsonLd?: Record<string, unknown>;
  /** Zenn に公開済みの記事。ブログ側は検索結果に出さず、Zenn の SEO と競合させない */
  noindex?: boolean;
  lang?: string;
  ogLocale?: string;
  /** 同じ記事の言語違い（自分を含む）。hreflang を出す */
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedAt,
  topics = [],
  jsonLd,
  noindex = false,
  lang = SITE.lang,
  ogLocale = 'ja_JP',
  alternates = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ui = Object.values(UI).find((u) => u.htmlLang === lang) ?? UI.ja;
const home = base + ui.home;
// 記事ページは同じ記事の別言語へ、それ以外は各言語のトップへ
const langLinks = Object.values(UI).map((u) => ({
  ...u,
  href: alternates.find((a) => a.lang === u.htmlLang)?.href ?? base + u.home,
  sameArticle: alternates.some((a) => a.lang === u.htmlLang),
}));
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const avatar = base + SITE.avatar;
const ogImage = new URL(base + (image ?? SITE.avatar), Astro.site).href;
const pageTitle = type === 'article' ? `${title} | ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.length > 1 &&
      alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site).href} />)}
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${base}/rss.xml`} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {topics.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href={avatar} />
    <link rel="apple-touch-icon" href={avatar} />
    {SITE.gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${SITE.gaId}');`}
        />
      </>
    )}
    {SITE.cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${SITE.cfAnalyticsToken}"}`}
      />
    )}
  </head>
  <body>
    <header>
      <a class="brand" href={home}>
        <img class="brand-avatar" src={avatar} alt="" width="30" height="30" loading="eager" />
        <span>{SITE.title}</span>
      </a>
      <nav class="lang-menu" aria-label="Language / 言語 / 语言">
        {langLinks.map((l) =>
          l.htmlLang === lang ? (
            <span aria-current="page" lang={l.htmlLang}>{l.label}</span>
          ) : (
            <a href={l.href} hreflang={l.htmlLang} lang={l.htmlLang} data-same={l.sameArticle ? '' : undefined}>
              {l.label}
            </a>
          ),
        )}
      </nav>
    </header>
    {
      lang === 'ja' && alternates.length > 1 && (
        <div class="lang-offer" hidden>
          {langLinks
            .filter((l) => l.sameArticle && l.offer)
            .map((l) => (
              <a href={l.href} hreflang={l.htmlLang} lang={l.htmlLang} data-offer={l.htmlLang.slice(0, 2)} hidden>
                {l.offer} →
              </a>
            ))}
          <button type="button" class="lang-offer-close" aria-label="閉じる / Close">×</button>
        </div>
      )
    }
    <main>
      <slot />
    </main>
    <script is:inline>
      // ブラウザの優先言語が日本語より英語・中国語を先に挙げていたら、翻訳版を案内する
      (() => {
        const box = document.querySelector('.lang-offer');
        if (!box) return;
        try { if (localStorage.getItem('lang-offer-dismissed')) return; } catch {}
        const prefs = (navigator.languages || [navigator.language]).map((l) => l.slice(0, 2).toLowerCase());
        const pick = prefs.find((l) => l === 'ja' || box.querySelector(`[data-offer="${l}"]`));
        const link = pick && pick !== 'ja' && box.querySelector(`[data-offer="${pick}"]`);
        if (!link) return;
        link.hidden = false;
        box.hidden = false;
        box.querySelector('.lang-offer-close').addEventListener('click', () => {
          box.hidden = true;
          try { localStorage.setItem('lang-offer-dismissed', '1'); } catch {}
        });
      })();
    </script>
    <footer>
      <a href={`${base}/rss.xml`}>RSS</a> ·
      <a href={SITE.authorUrl}>GitHub</a> · © {SITE.author}
    </footer>

    <style is:global>
      :root {
        --fg: #1a1a1a;
        --muted: #666;
        --line: #e3e3e3;
        --accent: #2563eb;
        --bg: #fff;
        --msg-bg: #f3f5f7;
        --alert-bg: #fdf0f0;
        --alert-line: #d9534f;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e6e6e6;
          --muted: #9aa0a6;
          --line: #333;
          --accent: #7aa2f7;
          --bg: #16181d;
          --msg-bg: #21242b;
          --alert-bg: #3a2224;
          --alert-line: #e06c75;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
        line-height: 1.8;
        font-size: 16px;
      }
      header, main, footer { max-width: 720px; margin: 0 auto; padding: 0 20px; }
      header {
        padding-top: 28px;
        padding-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }
      .lang-menu { display: flex; gap: 2px; font-size: 13px; }
      .lang-menu > * { padding: 4px 9px; border-radius: 999px; text-decoration: none; color: var(--muted); }
      .lang-menu a:hover { color: var(--fg); background: var(--msg-bg); }
      .lang-menu [aria-current] { color: var(--fg); background: var(--msg-bg); font-weight: 600; }
      .lang-offer {
        max-width: 680px;
        margin: -8px auto 24px;
        padding: 10px 8px 10px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 14px;
        background: var(--msg-bg);
        border-radius: 8px;
      }
      .lang-offer[hidden], .lang-offer a[hidden] { display: none; }
      .lang-offer a { text-decoration: none; }
      .lang-offer-close {
        flex: none;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: var(--muted);
        font-size: 18px;
        cursor: pointer;
      }
      .lang-offer-close:hover { color: var(--fg); background: var(--bg); }
      /* 中国語を日本語フォントで描くと字形が日本式になるので、本文フォントを言語で切り替える */
      html:lang(zh) body { font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif; }
      html:lang(en) body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif; }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        text-decoration: none;
        color: var(--fg);
      }
      .brand-avatar { border-radius: 50%; background: var(--msg-bg); }
      footer { color: var(--muted); font-size: 13px; padding-top: 48px; padding-bottom: 48px; }
      footer a { color: var(--muted); }
      a { color: var(--accent); }
      h1 { font-size: 1.7rem; line-height: 1.5; margin: 0 0 8px; }
      h2 { font-size: 1.3rem; margin: 2.4em 0 0.6em; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
      h3 { font-size: 1.1rem; margin: 2em 0 0.5em; }
      img { max-width: 100%; height: auto; }
      pre { padding: 14px 16px; border-radius: 8px; overflow-x: auto; font-size: 13.5px; line-height: 1.6; }
      code { font-size: 0.9em; }
      :not(pre) > code { background: var(--msg-bg); padding: 2px 5px; border-radius: 4px; }
      blockquote { margin: 1.4em 0; padding: 2px 16px; border-left: 4px solid var(--line); color: var(--muted); }
      table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 14px; }
      th, td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; }
      hr { border: 0; border-top: 1px solid var(--line); margin: 2.5em 0; }
      aside.msg {
        background: var(--msg-bg);
        border-radius: 8px;
        padding: 14px 18px;
        margin: 1.6em 0;
      }
      aside.msg.alert { background: var(--alert-bg); border-left: 4px solid var(--alert-line); }
      aside.msg > :first-child { margin-top: 0; }
      aside.msg > :last-child { margin-bottom: 0; }

      /* 記事リスト（サーバー生成・検索結果の両方で使う） */
      .list { list-style: none; padding: 0; margin: 0; }
      .list li { padding: 20px 0; border-bottom: 1px solid var(--line); }
      .head { display: flex; gap: 10px; text-decoration: none; color: var(--fg); font-weight: 600; line-height: 1.6; }
      .head:hover .title { color: var(--accent); }
      .emoji { flex: none; }
      .excerpt { margin: 6px 0 0; font-size: 14px; color: var(--muted); line-height: 1.7; }
      .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; font-size: 12px; color: var(--muted); }
      .tag { color: var(--muted); text-decoration: none; }
      a.tag:hover { color: var(--accent); }
      .tag::before { content: '#'; }
      .none { font-size: 13px; color: var(--muted); margin: 0 0 4px; }
      .pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-top: 28px;
        font-size: 14px;
        color: var(--muted);
      }
      .pager a { text-decoration: none; }
    </style>
  </body>
</html>
