---
interface Props {
  alternates: { lang: string; label: string; href: string }[];
  current: string;
}
const { alternates, current } = Astro.props;
---

{
  alternates.length > 1 && (
    <nav class="langs" aria-label="Language">
      {alternates.map((a) =>
        a.lang === current ? (
          <span aria-current="page">{a.label}</span>
        ) : (
          <a href={a.href} hreflang={a.lang} lang={a.lang}>
            {a.label}
          </a>
        ),
      )}
    </nav>
  )
}
