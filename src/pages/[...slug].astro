---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { publishedPosts, excerpt, firstImage, SITE } from '../posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = excerpt(post.body ?? '');
const image = firstImage(post.body ?? '');
const url = new URL(`${base}/${post.id}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  url,
  mainEntityOfPage: url,
  inLanguage: SITE.lang,
  author: { '@type': 'Person', name: SITE.author },
  keywords: post.data.topics.join(', '),
  ...(post.data.published_at ? { datePublished: post.data.published_at } : {}),
  ...(image ? { image: new URL(base + image, Astro.site).href } : {}),
};
---

<Base
  title={post.data.title}
  description={description}
  image={image}
  type="article"
  publishedAt={post.data.published_at}
  topics={post.data.topics}
  jsonLd={jsonLd}
>
  <article>
    <h1>{post.data.emoji ?? '📝'} {post.data.title}</h1>
    <div class="meta">
      {post.data.published_at && <time datetime={post.data.published_at}>{post.data.published_at}</time>}
      {post.data.topics.map((t) => <span class="tag">{t}</span>)}
    </div>
    <Content />
  </article>

  <style>
    .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; font-size: 12px; color: var(--muted); }
    .tag::before { content: '#'; }
  </style>
</Base>
