---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PostList from '../components/PostList.astro';
import SearchScript from '../components/SearchScript.astro';
import { publishedPosts, excerpt, SITE, UI, PER_PAGE } from '../posts';

const posts = await publishedPosts();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const page1 = posts.slice(0, PER_PAGE);
const lastPage = Math.max(1, Math.ceil(posts.length / PER_PAGE));

// クライアント検索用の索引（数十件なので丸ごと埋め込む）
const index = posts.map((p) => ({
  t: p.data.title,
  u: `${base}/${p.id}/`,
  e: p.data.emoji ?? '📝',
  d: p.data.published_at ?? '',
  g: p.data.topics,
  s: excerpt(p.body ?? '', 90),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.title,
  description: SITE.description,
  url: new URL(`${base}/`, Astro.site).href,
  inLanguage: SITE.lang,
  author: { '@type': 'Person', name: SITE.author, url: SITE.authorUrl },
};
---

<Base title={SITE.title} jsonLd={jsonLd}>
  <section class="hero">
    <img class="hero-avatar" src={base + SITE.avatar} alt="すみと黒" width="84" height="84" loading="eager" />
    <div>
      <h1>すみ<span class="amp">と</span>黒</h1>
      <p class="bio">{SITE.bio}</p>
    </div>
  </section>

  <Nav search />

  <div id="results" hidden></div>

  <div id="server-list">
    <PostList posts={page1} />
    {
      lastPage > 1 && (
        <nav class="pager">
          <span>1 / {lastPage}</span>
          <a href={`${base}/page/2/`}>次へ →</a>
        </nav>
      )
    }
  </div>

  <SearchScript index={index} count={UI.ja.count} none={UI.ja.none} />

  <style>
    .hero { display: flex; align-items: center; gap: 18px; margin-bottom: 32px; }
    .hero-avatar { border-radius: 50%; flex: none; background: var(--msg-bg); }
    .hero h1 { font-size: 1.35rem; margin: 0 0 6px; }
    .amp { color: var(--muted); font-weight: 400; margin: 0 2px; }
    .bio { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.7; }
  </style>
</Base>
